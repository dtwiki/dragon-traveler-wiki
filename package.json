{
  "name": "dragon-traveler-wiki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner && node scripts/generate-route-pages.mjs",
    "validate:pages": "node scripts/validate-pages-build.mjs",
    "build:analyze": "tsc -b && vite build --configLoader runner --mode analyze",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm run test && npm run typecheck",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@types/three": "^0.186.0",
    "d3-hierarchy": "^3.1.2",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
